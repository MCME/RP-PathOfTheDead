# A resource pack repository: only OS, editor and temporary clutter is ignored.
# Never ignore *.obj: the 3D models are part of the pack, and a release without
# them shows missing blocks. See
# https://github.com/MCME/ResourcePackScripts/blob/master/docs/pack-repository.md#gitignore

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/

# Editors
.idea/
*.iml
.vscode/
*.swp
*~

# Temporary and backup files
*.tmp
*.bak
*.log

# Python helper scripts
__pycache__/
*.py[cod]
